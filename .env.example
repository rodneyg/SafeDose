# Stripe mode and keys
STRIPE_MODE=test
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_TEST_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Optional legacy price IDs used by compatibility checkout paths.
STRIPE_TEST_PRICE_ID=price_REPLACE_ME

# Live deployment values. Keep live credentials in the hosting provider, not in source control.
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_LIVE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_LIVE_PRICE_ID=price_REPLACE_ME

# Optional overrides for the current Photo Scan offers. When unset, checkout uses Stripe
# lookup keys safedose_photo_check_monthly / safedose_photo_check_annual.
STRIPE_PHOTO_CHECK_MONTHLY_PRICE_ID=price_REPLACE_ME
STRIPE_PHOTO_CHECK_ANNUAL_PRICE_ID=price_REPLACE_ME

# Firebase client configuration
FIREBASE_API_KEY=REPLACE_ME
FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
FIREBASE_PROJECT_ID=REPLACE_ME
FIREBASE_STORAGE_BUCKET=REPLACE_ME.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
FIREBASE_APP_ID=REPLACE_ME
FIREBASE_MEASUREMENT_ID=REPLACE_ME

# Firebase Admin credentials required by authenticated billing endpoints.
# Store these as server environment variables. Do not add them to app.config extra.
FIREBASE_CLIENT_EMAIL=REPLACE_ME
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Google OAuth Configuration (for Google Sign-In)
GOOGLE_WEB_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# Server-side only. Used by /api/analyze-scan. Do not expose in the browser bundle.
OPENAI_API_KEY=REPLACE_ME

# Opt in at build time to check photo quality before uploading a scan.
EXPO_PUBLIC_SCAN_QUALITY_PRECHECK=false

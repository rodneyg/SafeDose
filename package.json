{
  "name": "safedose",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "rimraf dist && CI=1 EXPO_NO_TELEMETRY=1 expo export --platform web --output-dir dist && node scripts/generate-service-worker.js",
    "build:functions": "esbuild api/*.js --bundle --platform=node --target=node16 --outdir=functions",
    "build": "npm run build:web",
    "test": "jest",
    "test:vercel-ignore": "node --test scripts/vercel-ignore.test.mjs",
    "lint": "expo lint",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test:dosing": "jest lib/dosing tests/ --runInBand --coverage --collectCoverageFrom='lib/dosing/**/*.ts' --collectCoverageFrom='!lib/dosing/**/__tests__/**'",
    "typecheck:dose-calculator-props": "tsc -p tsconfig.dose-calculator-props.json",
    "typecheck:dosing": "tsc --noEmit -p tsconfig.dosing.json",
    "eval:vision": "tsc -p tsconfig.vision.json && node .eval-cache/evals/vision/run.js",
    "test:vision": "jest lib/scan evals/vision --runInBand",
    "typecheck:vision": "tsc --noEmit -p tsconfig.vision.json",
    "test:demo-leftovers": "jest components/SAF137.test.tsx components/ManualEntryScreen.strength.test.tsx components/PhotoScanErrors.integration.test.tsx --runInBand",
    "test:dose-flow": "jest components/SAF137.test.tsx components/SAF314.test.tsx --runInBand",
    "typecheck:api": "tsc --noEmit -p api/tsconfig.json",
    "test:scan-api": "jest api/__tests__/analyze-scan.test.js lib/scan/__tests__/completeOnServer.test.ts --runInBand",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.js",
    "verify": "./verify",
    "rollback": "node scripts/rollback.mjs",
    "vision:validate-labels": "node evals/vision/validate-labels.js",
    "vision:check-exif": "node evals/vision/check-exif.js",
    "vision:strip-exif": "node evals/vision/strip-exif.js",
    "test:vision-labeling": "jest evals/vision/__tests__/labeling-tools.test.js --runInBand",
    "check:vision-labeling": "npm run vision:validate-labels && npm run vision:check-corpus && npm run vision:check-exif && npm run test:vision-labeling",
    "vision:check-corpus": "node evals/vision/check-corpus.js",
    "changelog:build": "node scripts/changelog.js build",
    "changelog:add": "node scripts/changelog.js add",
    "prebuild:web": "npm run changelog:build",
    "prestart": "npm run changelog:build",
    "predev": "npm run changelog:build",
    "e2e:prod-scan": "playwright test --config playwright.prod.config.ts",
    "smoke:prod": "node scripts/prod-smoke.mjs",
    "test:dependabot-config": "node --test scripts/dependabot-config.test.mjs"
  },
  "vercel": {
    "projectRoot": "."
  },
  "dependencies": {
    "@expo/cli": "latest",
    "@expo/vector-icons": "^14.0.2",
    "@lucide/lab": "^0.1.2",
    "@radix-ui/react-toast": "^1.3.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@stripe/stripe-js": "^7.2.0",
    "@types/stripe": "^8.0.416",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^16.5.0",
    "expo": "^52.0.42",
    "expo-blur": "^14.0.3",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.15",
    "expo-font": "^13.0.3",
    "expo-haptics": "^14.0.1",
    "expo-linear-gradient": "^14.0.2",
    "expo-linking": "^7.0.5",
    "expo-network": "~7.0.5",
    "expo-router": "^4.0.19",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "^2.0.1",
    "expo-symbols": "^0.2.2",
    "expo-system-ui": "^4.0.7",
    "expo-web-browser": "~14.0.2",
    "firebase": "^11.6.1",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.7.4",
    "lucide-react": "^0.488.0",
    "lucide-react-native": "^0.475.0",
    "micro": "^10.0.1",
    "nativewind": "~4.2.7",
    "openai": "^7.59.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-paper": "^5.13.1",
    "react-native-picker-select": "^9.3.1",
    "react-native-reanimated": "^3.17.5",
    "react-native-safe-area-context": "^4.14.1",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.19.13",
    "react-native-webview": "13.12.5",
    "stripe": "^18.0.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.1.4",
    "@playwright/test": "^1.65.1",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.2",
    "ajv": "8.11.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "exiftool-vendored": "^30.5.0",
    "expo-cli": "^6.3.12",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "playwright": "^1.65.1",
    "react-test-renderer": "^18.3.1",
    "rimraf": "^6.0.1",
    "safe-buffer": "^5.2.1",
    "ts-jest": "^29.4.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "vercel": "^28.4.8"
  },
  "overrides": {
    "ts-node": "10.9.1",
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.13.6"
    },
    "minimatch@3": "^3.1.5",
    "nanoid@3": "^3.3.20",
    "path-to-regexp@0.1": "~0.1.13",
    "path-to-regexp@6": "^6.3.0",
    "qs@6": "^6.16.2",
    "semver@6": "^6.3.1",
    "semver@7": "^7.5.2",
    "@expo/metro-config": {
      "postcss": "^8.5.23"
    }
  },
  "@vercel/node": {
    "ts-node": "10.9.1",
    "typescript": "4.8.4"
  },
  "engines": {
    "node": "22.x"
  }
}

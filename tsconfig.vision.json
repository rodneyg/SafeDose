{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "jest"
    ],
    "skipLibCheck": true,
    "outDir": ".eval-cache",
    "rootDir": ".",
    "allowJs": true
  },
  "include": [
    "lib/scan/**/*.ts",
    "lib/scan/**/*.js",
    "lib/scan/**/*.d.ts",
    "lib/dosing/**/*.ts",
    "evals/vision/**/*.ts"
  ]
}

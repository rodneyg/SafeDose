{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "outDir": ".eval-cache",
    "rootDir": "."
  },
  "include": ["lib/scan/**/*.ts", "lib/dosing/**/*.ts", "evals/vision/**/*.ts"]
}
